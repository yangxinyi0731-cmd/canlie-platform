# 餐猎平台后端环境变量
# 复制为 .env 并填入真实值（.env 切勿提交到 git）

# 运行环境：production | development
NODE_ENV=development

# 服务端口（默认 3001）
PORT=3001

# JWT 签名密钥 —— 生产环境必须设置强随机值，否则后端拒绝启动
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# 数据库（Prisma，SQLite 默认 dev.db）
DATABASE_URL="file:./dev.db"
