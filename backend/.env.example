# 餐猎平台后端环境变量
# 复制为 .env 并填入真实值（.env 切勿提交到 git）

# 运行环境：production | development
NODE_ENV=development

# 服务端口（默认 3001）
PORT=3001

# JWT 签名密钥 —— 生产环境必须设置强随机值，否则后端拒绝启动
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# 密码重置验证码：生产环境必须配置 HTTPS webhook 和鉴权 token。
# 开发环境可把 URL 指向本机 loopback mock；后端不会在响应或日志中显示验证码。
RESET_SMS_WEBHOOK_URL=
RESET_SMS_WEBHOOK_TOKEN=
# 可选；不填时使用 JWT_SECRET 作为带域隔离的 HMAC 密钥。
PASSWORD_RESET_HASH_SECRET=

# Seed 登录密码（生产环境执行 seed 时必填；至少 16 字节）
# 不填时，非生产环境会为本次 seed 生成随机密码且不会打印明文。
SEED_ADMIN_PASSWORD=
SEED_ENTERPRISE_PASSWORD=
SEED_TALENT_PASSWORD=

# 数据库（Prisma，SQLite 默认 dev.db）
DATABASE_URL="file:./dev.db"
